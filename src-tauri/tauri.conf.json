{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleuron",
  "version": "2.7.0",
  "identifier": "study.fleuron.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Fleuron",
        "dragDropEnabled": false,
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "preventOverflow": {
          "width": 16,
          "height": 16
        },
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "fleuron",
          "codemap",
          "qcproj"
        ],
        "name": "Fleuron Project",
        "mimeType": "application/x-fleuron",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "category": "Productivity",
    "shortDescription": "Qualitative coding for reflexive thematic analysis",
    "longDescription": "Offline-first qualitative coding for reflexive thematic analysis. Import transcripts, code passages with a living codebook, memo as you go, and export coded segments. Work fully locally, or collaborate over encrypted hosted sync — collaboration sync excludes transcript text and memo fields.",
    "copyright": "Fleuron contributors",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "infoPlist": "Info.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5Q0NBNzAzOUQyOTA1NjIKUldSaUJTbWRBNmZNbWRTVytqSHM3aHJ2VEpneDJVOFRlNWNYNGdkTHRQMzhzNy9TZTkrV25PaXgK",
      "endpoints": [
        "https://github.com/wilsonhyeh/fleuron/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
